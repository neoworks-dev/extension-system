{
  "name": "@neoworks/extension-system",
  "description": "Plugin kernel with revertible effects and reactive dependency resolution",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/neoworks-dev/extension-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoworks-dev/extension-system.git"
  },
  "bugs": {
    "url": "https://github.com/neoworks-dev/extension-system/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    ".claude-plugin"
  ],
  "scripts": {
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./lib --target browser --format esm --sourcemap=linked",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rm -rf lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@swc/core": "^1.16.1",
    "@types/node": "^25.3.5",
    "oxlint": "^1.9.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.5"
  }
}
